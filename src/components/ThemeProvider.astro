---
import { Icon } from '@astrojs/starlight/components';
---

{/* Client-side password protection gate */}
<script is:inline>
	(() => {
		const AUTH_KEY = 'hw_auth_granted';
		if (typeof window === 'undefined') return;

		// Check if user is already authenticated in current browser session
		if (sessionStorage.getItem(AUTH_KEY) === 'true') return;

		// Instantly hide page content before rendering to prevent flash
		const hideStyle = document.createElement('style');
		hideStyle.id = 'auth-hide-style';
		hideStyle.textContent = 'html { visibility: hidden !important; background: #09090b !important; }';
		document.head.appendChild(hideStyle);

		document.addEventListener('DOMContentLoaded', () => {
			if (sessionStorage.getItem(AUTH_KEY) === 'true') {
				if (hideStyle.parentNode) hideStyle.remove();
				document.documentElement.style.visibility = 'visible';
				return;
			}

			// Render sleek lock screen modal
			const modal = document.createElement('div');
			modal.id = 'hw-lock-screen';
			modal.setAttribute(
				'style',
				'position:fixed;inset:0;z-index:9999999;background:#09090b;color:#ffffff;display:flex;align-items:center;justify-content:center;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;padding:1.5rem;'
			);

			modal.innerHTML = `
				<div style="background:#18181b;border:1px solid #27272a;border-radius:14px;padding:2.5rem 2rem;width:100%;max-width:380px;box-shadow:0 25px 50px -12px rgba(0,0,0,0.7);text-align:center;box-sizing:border-box;">
					<div style="width:52px;height:52px;background:#27272a;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1.25rem;">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
							<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
						</svg>
					</div>
					<h2 style="font-size:1.3rem;font-weight:700;margin:0 0 0.4rem;color:#ffffff;letter-spacing:-0.01em;line-height:1.3;">Tim Blake<br />Halfords Knowledge Wiki</h2>
					<p style="font-size:0.875rem;color:#a1a1aa;margin:0 0 1.5rem;line-height:1.4;">This portal is password protected. Enter your password to continue.</p>
					<form id="hw-lock-form" style="display:flex;flex-direction:column;gap:0.85rem;">
						<input type="password" id="hw-lock-input" placeholder="Password" required style="width:100%;padding:0.75rem 1rem;border-radius:8px;border:1px solid #3f3f46;background:#09090b;color:#ffffff;font-size:0.95rem;outline:none;box-sizing:border-box;transition:border-color 150ms;" />
						<button type="submit" style="width:100%;padding:0.75rem 1rem;border-radius:8px;border:none;background:#ffffff;color:#000000;font-weight:700;font-size:0.925rem;cursor:pointer;transition:opacity 150ms;">Unlock Site</button>
						<p id="hw-lock-error" style="color:#f43f5e;font-size:0.8rem;font-weight:600;margin:0.25rem 0 0;display:none;">Incorrect password. Please try again.</p>
					</form>
				</div>
			`;

			document.body.appendChild(modal);
			if (hideStyle.parentNode) hideStyle.remove();
			document.documentElement.style.visibility = 'visible';

			const form = document.getElementById('hw-lock-form');
			const input = document.getElementById('hw-lock-input');
			const errorMsg = document.getElementById('hw-lock-error');

			if (input) input.focus();

			if (form) {
				form.addEventListener('submit', (e) => {
					e.preventDefault();
					const val = input ? input.value.trim().toLowerCase() : '';
					// Accept both half0rds124 (number 0) and halfords124 (letter o)
					if (val === 'half0rds124' || val === 'halfords124') {
						sessionStorage.setItem(AUTH_KEY, 'true');
						modal.remove();
					} else {
						if (errorMsg) errorMsg.style.display = 'block';
						if (input) {
							input.style.borderColor = '#f43f5e';
							input.value = '';
							input.focus();
						}
					}
				});
			}
		});
	})();
</script>

{/* Set light mode on a visitor's first visit while preserving later choices. */}
<script is:inline>
	window.StarlightThemeProvider = (() => {
		const storageKey = 'starlight-theme';
		const savedTheme =
			typeof localStorage !== 'undefined' ? localStorage.getItem(storageKey) : null;
		const storedTheme = savedTheme === null ? 'light' : savedTheme;

		if (savedTheme === null && typeof localStorage !== 'undefined') {
			localStorage.setItem(storageKey, 'light');
		}

		const theme =
			storedTheme ||
			(window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
		document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';

		return {
			updatePickers(theme = storedTheme || 'auto') {
				document.querySelectorAll('starlight-theme-select').forEach((picker) => {
					const select = picker.querySelector('select');
					if (select) select.value = theme;
					const tmpl = document.querySelector('#theme-icons');
					const newIcon = tmpl && tmpl.content.querySelector('.' + theme);
					if (newIcon) {
						const oldIcon = picker.querySelector('svg.label-icon');
						if (oldIcon) {
							oldIcon.replaceChildren(...newIcon.cloneNode(true).childNodes);
						}
					}
				});
			},
		};
	})();
</script>

<template id="theme-icons">
	<Icon name="sun" class="light" />
	<Icon name="moon" class="dark" />
	<Icon name="laptop" class="auto" />
</template>
