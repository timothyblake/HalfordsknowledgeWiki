<section class="converter" aria-labelledby="filtered-links-title">
	<div class="converter__header">
		<div>
			<p class="converter__eyebrow">PWA utility</p>
			<h2 id="filtered-links-title">Convert filtered links</h2>
			<p>
				Paste HTML containing legacy <code>prefn</code> and <code>prefv</code> filters. Every
				matching link is converted to the PWA <code>fq</code> format.
			</p>
		</div>
	</div>

	<div class="converter__field">
		<div class="converter__label-row">
			<label for="filtered-links-input">HTML to convert</label>
			<span>Supports multiple filters and values</span>
		</div>
		<textarea
			id="filtered-links-input"
			rows="12"
			spellcheck="false"
			placeholder={'<a href="$url(\'Search-Show\',\'cgid\',\'501209\')$?prefn1=brandname&prefv1=Boardman">Boardman</a>'}
		></textarea>
	</div>

	<div class="converter__actions">
		<button class="button button--primary" id="convert-filtered-links" type="button">Convert links</button>
		<button class="button" id="clear-filtered-links" type="button">Clear</button>
	</div>

	<div class="converter__field converter__result" hidden>
		<div class="converter__label-row">
			<label for="filtered-links-output">Converted HTML</label>
			<span id="filtered-links-status" role="status" aria-live="polite"></span>
		</div>
		<textarea id="filtered-links-output" rows="12" spellcheck="false" readonly></textarea>
		<div class="converter__actions converter__actions--result">
			<button class="button" id="copy-filtered-links" type="button">Copy converted HTML</button>
		</div>
	</div>
</section>

<script>
	import { convertBrandLinks } from '../../utils/convert-filtered-links.js';

	const input = document.querySelector('#filtered-links-input');
	const output = document.querySelector('#filtered-links-output');
	const result = document.querySelector('.converter__result');
	const status = document.querySelector('#filtered-links-status');
	const convertButton = document.querySelector('#convert-filtered-links');
	const copyButton = document.querySelector('#copy-filtered-links');
	const clearButton = document.querySelector('#clear-filtered-links');

	function setStatus(message) {
		if (status) status.textContent = message;
	}

	convertButton?.addEventListener('click', () => {
		if (!(input instanceof HTMLTextAreaElement) || !(output instanceof HTMLTextAreaElement)) return;

		const source = input.value;
		if (!source.trim()) {
			input.focus();
			setStatus('Add some HTML first.');
			if (result instanceof HTMLElement) result.hidden = false;
			return;
		}

		const converted = convertBrandLinks(source);
		output.value = converted.html;
		if (result instanceof HTMLElement) result.hidden = false;
		setStatus(
			converted.count === 0
				? 'No legacy filter links found.'
				: `${converted.count} ${converted.count === 1 ? 'link' : 'links'} converted.`,
		);
	});

	copyButton?.addEventListener('click', async () => {
		if (!(output instanceof HTMLTextAreaElement) || !output.value) return;

		try {
			await navigator.clipboard.writeText(output.value);
			setStatus('Converted HTML copied.');
		} catch {
			output.select();
			document.execCommand('copy');
			setStatus('Converted HTML copied.');
		}
	});

	clearButton?.addEventListener('click', () => {
		if (input instanceof HTMLTextAreaElement) {
			input.value = '';
			input.focus();
		}
		if (output instanceof HTMLTextAreaElement) output.value = '';
		if (result instanceof HTMLElement) result.hidden = true;
		setStatus('');
	});
</script>

